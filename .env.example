# ============================================================
# 环境变量模板：复制为 .env 后填入真实值（.env 已被 .gitignore 排除）
# ============================================================

# --- LLM（OpenAI 兼容接口，可与 Embedding 分属不同厂商）---
# LLM 客户端优先读 LLM_API_KEY/LLM_API_BASE；未设置时回退到 OPENAI_API_KEY/OPENAI_API_BASE
# 示例：火山方舟 Coding Plan（OpenAI 兼容端点）
LLM_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_API_KEY=你的方舟密钥
LLM_DISABLE_THINKING=true
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_DEFAULT_TEMPERATURE=0.1
ITEM_MODEL=deepseek-v4-flash
KG_MODEL=deepseek-v4-flash

# --- Embedding / Rerank（DashScope）---
OPENAI_API_KEY=sk-你的密钥
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIM=1024
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=gte-rerank-v2

# --- Milvus Lite ---
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_entity_names
ITEM_NAME_COLLECTION=kb_item_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=你的密码
NEO4J_DATABASE=neo4j

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=kb001

# --- MinIO（图片对象存储，可选）---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base
